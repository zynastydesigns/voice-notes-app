# Firebase Web/App config (safe to expose client-side; security is enforced
# by Firestore/Storage security rules, not by hiding these values).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Sign-In (from Google Cloud Console / Firebase Auth provider setup)
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Gemini API key (from Google AI Studio) — used client-side to transcribe and
# summarize recordings after Save. Note this ships inside the app bundle, so
# it is visible to anyone who inspects it; restrict it (HTTP referrer / app
# bundle ID / API restrictions) in Google Cloud Console, and prefer routing
# this call through a Cloud Function once one exists for this project.
EXPO_PUBLIC_GEMINI_API_KEY=
